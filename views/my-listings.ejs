<%- include("partials/header",{title:"My Listings"}) %>

<%- include("partials/navbar",{user:user}) %>

<section class="bikes-section">

    <h1>My Bike Listings</h1>

    <% if(bikes.length===0){ %>

        <div style="text-align:center;margin-top:50px;">

            <h2>No Bikes Posted Yet</h2>

            <br>

            <a href="/sell-bike" class="view-btn">

                Sell Your First Bike

            </a>

        </div>

    <% } else { %>

        <div class="bike-grid">

            <% bikes.forEach(bike=>{ %>

                <div class="bike-card">

                    <div class="bike-image">

                        <img
                        src="<%= bike.image ? '/uploads/bikes/' + bike.image : '/uploads/bikes/default-bike.jpg' %>"
                        alt="Bike">

                    </div>

                    <div class="bike-content">

                        <h2>

                            <%= bike.bike_name %>

                        </h2>

                        <p>

                            <strong>Brand:</strong>

                            <%= bike.brand %>

                        </p>

                        <p>

                            <strong>Model:</strong>

                            <%= bike.model %>

                        </p>

                        <p>

                            <strong>Year:</strong>

                            <%= bike.year %>

                        </p>

                        <h3>

                            ₹ <%= bike.price %>

                        </h3>

                        <div style="display:flex;gap:10px;margin-top:20px;">

                            <a
                            href="/bikes/<%= bike.id %>"
                            class="view-btn"
                            style="flex:1;text-align:center;">

                                View

                            </a>

                            <a
                            href="/edit-bike/<%= bike.id %>"
                            class="view-btn"
                            style="flex:1;text-align:center;background:#f59e0b;">

                                Edit

                            </a>

                            <a
                            href="/delete-bike/<%= bike.id %>"
                            class="view-btn"
                            style="flex:1;text-align:center;background:#dc2626;"
                            onclick="return confirm('Delete this bike?')">

                                Delete

                            </a>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</section>

<%- include("partials/footer") %>