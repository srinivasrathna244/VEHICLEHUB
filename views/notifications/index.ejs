<%- include('../partials/header', {title: 'Notifications'}) %>
<%- include('../partials/navbar') %>

<div class="notifications-page">
    <div class="container" style="max-width:800px">
        <div class="page-header">
            <div>
                <h1><i class="fas fa-bell"></i> Notifications</h1>
                <p>Stay updated on inquiries, reviews, and listing activity.</p>
            </div>
            <% if (notifications.length > 0) { %>
            <form action="/notifications/read-all" method="POST">
                <button type="submit" class="btn btn-sm btn-outline"><i class="fas fa-check-double"></i> Mark all read</button>
            </form>
            <% } %>
        </div>

        <% if (notifications.length === 0) { %>
        <div class="empty-state-large">
            <i class="far fa-bell-slash"></i>
            <h3>No notifications</h3>
            <p>You're all caught up! Updates regarding your listings and messages will appear here.</p>
        </div>
        <% } else { %>
        <div class="notifications-list">
            <% notifications.forEach(n => { %>
            <div class="notification-item <%= !n.is_read ? 'unread' : '' %> type-<%= n.type || 'info' %>">
                <div class="notif-icon">
                    <% if (n.type === 'success') { %><i class="fas fa-check-circle" style="color:#16a34a"></i>
                    <% } else if (n.type === 'error') { %><i class="fas fa-exclamation-circle" style="color:#ef4444"></i>
                    <% } else { %><i class="fas fa-info-circle" style="color:#2563eb"></i><% } %>
                </div>
                <div class="notif-body">
                    <div class="notif-title"><%= n.title %></div>
                    <div class="notif-msg"><%= n.message %></div>
                    <div class="notif-time"><%= new Date(n.created_at).toLocaleString('en-IN', {month:'short', day:'numeric', hour:'2-digit', minute:'2-digit'}) %></div>
                </div>
                <% if (n.link) { %>
                <a href="<%= n.link %>" class="btn btn-sm btn-outline notif-action">View</a>
                <% } %>
            </div>
            <% }) %>
        </div>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>
