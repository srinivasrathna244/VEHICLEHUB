<%- include('../partials/header', {title: 'Audit Logs'}) %>
<%- include('../partials/navbar') %>

<div class="admin-page">
    <div class="container">
        <div class="admin-header">
            <div>
                <h1><i class="fas fa-history"></i> Administrative Audit Logs</h1>
                <p>Immutable log of administrative and moderation actions for platform security.</p>
            </div>
            <a href="/admin" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Dashboard</a>
        </div>

        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Timestamp</th>
                        <th>Admin</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (logs.length === 0) { %>
                    <tr><td colspan="5" class="text-center">No audit records recorded yet.</td></tr>
                    <% } else { %>
                    <% logs.forEach(l => { %>
                    <tr>
                        <td><small><%= new Date(l.created_at).toLocaleString('en-IN') %></small></td>
                        <td><strong><%= l.admin_name %></strong><div class="text-muted"><%= l.admin_email %></div></td>
                        <td><span class="role-badge"><%= l.action %></span></td>
                        <td><%= l.entity_type %> #<%= l.entity_id %></td>
                        <td><%= l.description %></td>
                    </tr>
                    <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
