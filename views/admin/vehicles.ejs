<%- include('../partials/header', {title: 'Manage Vehicles'}) %>
<%- include('../partials/navbar') %>

<div class="admin-page">
    <div class="container">
        <div class="admin-header">
            <div>
                <h1><i class="fas fa-car"></i> Vehicle Moderation</h1>
                <p>Total Listings: <%= totalVehicles %></p>
            </div>
            <a href="/admin" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Dashboard</a>
        </div>

        <!-- Filter Bar -->
        <form action="/admin/vehicles" method="GET" class="admin-filter-bar">
            <input type="text" name="search" class="form-control" placeholder="Search by title, brand, reg number..." value="<%= filters.search || '' %>">
            <select name="status" class="form-control" style="max-width:140px">
                <option value="">All Statuses</option>
                <option value="ACTIVE" <%= filters.status === 'ACTIVE' ? 'selected' : '' %>>Active</option>
                <option value="PENDING" <%= filters.status === 'PENDING' ? 'selected' : '' %>>Pending</option>
                <option value="SOLD" <%= filters.status === 'SOLD' ? 'selected' : '' %>>Sold</option>
                <option value="REJECTED" <%= filters.status === 'REJECTED' ? 'selected' : '' %>>Rejected</option>
            </select>
            <select name="category" class="form-control" style="max-width:160px">
                <option value="">All Categories</option>
                <% categories.forEach(c => { %>
                <option value="<%= c.id %>" <%= filters.category == c.id ? 'selected' : '' %>><%= c.name %></option>
                <% }) %>
            </select>
            <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Filter</button>
            <a href="/admin/vehicles" class="btn btn-outline">Reset</a>
        </form>

        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Vehicle</th>
                        <th>Seller</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Views</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% vehicles.forEach(v => { %>
                    <tr>
                        <td><%= v.id %></td>
                        <td>
                            <div class="admin-table-veh">
                                <img src="<%= v.primary_image ? (v.primary_image.startsWith('http') ? v.primary_image : '/uploads/vehicles/' + v.primary_image) : '/images/no-vehicle.jpg' %>" alt="<%= v.title %>" class="admin-veh-thumb" onerror="this.src='/images/no-vehicle.jpg'">
                                <div>
                                    <strong><%= v.title %></strong>
                                    <div class="text-muted"><%= v.manufacturing_year %> &bull; <%= v.kilometers ? v.kilometers.toLocaleString('en-IN') + ' km' : '' %> &bull; <%= v.registration_city || '' %></div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div><%= v.seller_name %></div>
                            <small class="text-muted"><%= v.seller_email %></small>
                        </td>
                        <td><span class="category-pill"><%= v.category_name %></span></td>
                        <td><strong>₹ <%= Number(v.price).toLocaleString('en-IN') %></strong></td>
                        <td><%= v.views_count %></td>
                        <td><span class="status-badge status-<%= v.status.toLowerCase() %>"><%= v.status %></span></td>
                        <td>
                            <div class="action-btns">
                                <a href="/vehicles/<%= v.id %>" target="_blank" class="btn-action view" title="View"><i class="fas fa-eye"></i></a>
                                <% if (v.status === 'PENDING' || v.status === 'REJECTED') { %>
                                <form action="/admin/vehicles/approve" method="POST" style="display:inline">
                                    <input type="hidden" name="vehicle_id" value="<%= v.id %>">
                                    <button type="submit" class="btn-action sold" title="Approve"><i class="fas fa-check"></i></button>
                                </form>
                                <% } %>
                                <% if (v.status === 'ACTIVE' || v.status === 'PENDING') { %>
                                <button class="btn-action delete" title="Reject" onclick="openRejectModal('<%= v.id %>', '<%= v.title %>')"><i class="fas fa-times"></i></button>
                                <% } %>
                                <form action="/admin/vehicles/delete" method="POST" style="display:inline" onsubmit="return confirm('Permanently delete listing? This cannot be undone.')">
                                    <input type="hidden" name="vehicle_id" value="<%= v.id %>">
                                    <button type="submit" class="btn-action delete" title="Delete"><i class="fas fa-trash-alt"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal-overlay" id="rejectModal" style="display:none">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Reject Vehicle Listing</h3>
            <button class="modal-close" onclick="document.getElementById('rejectModal').style.display='none'">&times;</button>
        </div>
        <form action="/admin/vehicles/reject" method="POST">
            <input type="hidden" name="vehicle_id" id="rejectVehicleId">
            <p>You are rejecting <strong id="rejectVehicleTitle"></strong>.</p>
            <div class="form-group mt-16">
                <label>Rejection Reason</label>
                <textarea name="rejection_reason" class="form-control" rows="3" required placeholder="Specify reason for rejection..."></textarea>
            </div>
            <button type="submit" class="btn btn-danger btn-block">Reject Listing</button>
        </form>
    </div>
</div>

<script>
function openRejectModal(id, title) {
    document.getElementById('rejectVehicleId').value = id;
    document.getElementById('rejectVehicleTitle').textContent = title;
    document.getElementById('rejectModal').style.display = 'flex';
}
</script>

<%- include('../partials/footer') %>
