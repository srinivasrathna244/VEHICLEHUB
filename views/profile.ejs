
<%- include("partials/header",{title:"Profile"}) %>

<%- include("partials/navbar",{user:user}) %>



<section class="profile-container">


    <div class="profile-card">


        <h1>

            My Profile

        </h1>



        <div class="profile-info">


            <p>

                <strong>First Name:</strong>

                <%= user.first_name %>

            </p>



            <p>

                <strong>Last Name:</strong>

                <%= user.last_name %>

            </p>



            <p>

                <strong>Email:</strong>

                <%= user.email %>

            </p>



            <p>

                <strong>Phone:</strong>

                <%= user.phone %>

            </p>



            <p>

                <strong>Address:</strong>

                <%= user.address || "Not Added" %>

            </p>



            <p>

                <strong>City:</strong>

                <%= user.city || "Not Added" %>

            </p>



            <p>

                <strong>State:</strong>

                <%= user.state || "Not Added" %>

            </p>



            <p>

                <strong>Pincode:</strong>

                <%= user.pincode || "Not Added" %>

            </p>



        </div>




        <a href="/dashboard" class="profile-btn">

            Dashboard

        </a>

        <a href="/edit-profile" class="view-btn">

            Edit Profile

        </a>

    </div>



</section>



<%- include("partials/footer") %>