<%- include("partials/header",{title:"Bike Details"}) %>

<%- include("partials/navbar",{user:user}) %>


<section class="details-container">


    <div class="details-box">


        <div class="image-gallery">


            <% if(images.length > 0){ %>


                <% images.forEach(image=>{ %>


                    <img

                    src="/uploads/bikes/<%= image.image %>"

                    alt="Bike Image"

                    class="bike-detail-image">


                <% }) %>



            <% } else { %>


                <img

                src="/uploads/bikes/default-bike.jpg"

                class="bike-detail-image">


            <% } %>


        </div>





        <div class="bike-info">


            <h1>

                <%= bike.bike_name %>

            </h1>



            <h2>

                ₹ <%= bike.price %>

            </h2>




            <p>

                <strong>Brand:</strong>

                <%= bike.brand %>

            </p>



            <p>

                <strong>Model:</strong>

                <%= bike.model %>

            </p>



            <p>

                <strong>Year:</strong>

                <%= bike.year %>

            </p>



            <p>

                <strong>Kilometers:</strong>

                <%= bike.kilometers %> KM

            </p>



            <p>

                <strong>Fuel:</strong>

                <%= bike.fuel_type %>

            </p>



            <p>

                <strong>Transmission:</strong>

                <%= bike.transmission %>

            </p>



            <p>

                <strong>Owner:</strong>

                <%= bike.owner_type %>

            </p>



            <p>

                <strong>Location:</strong>

                <%= bike.city %>

            </p>




            <p class="description">

                <%= bike.description %>

            </p>





            <div class="seller">


                <h3>

                    Seller Details

                </h3>


                <p>

                    Name:

                    <%= bike.first_name %>

                </p>


                <p>

                    Phone:

                    <%= bike.phone %>

                </p>



            </div>




            <a

    href="tel:<%= bike.phone %>"

    class="contact-btn">

    📞 Call Seller

</a>

<br><br>

<a

    href="https://wa.me/91<%= bike.phone %>?text=Hi, I am interested in your <%= bike.bike_name %>."

    target="_blank"

    class="contact-btn">

    💬 WhatsApp Seller

</a>



        </div>



    </div>



</section>



<%- include("partials/footer") %>