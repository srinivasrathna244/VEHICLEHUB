<%- include("partials/header",{title:"Bikes"}) %>

<%- include("partials/navbar",{user:user}) %>


<section class="bikes-section">

    <h1>Available Bikes</h1>

    <form action="/search" method="GET" class="search-form">

        <input
            type="text"
            name="search"
            placeholder="Search Bike Name">

        <select name="brand">

            <option value="">All Brands</option>

            <option value="Honda">Honda</option>

            <option value="Hero">Hero</option>

            <option value="Royal Enfield">Royal Enfield</option>

            <option value="Yamaha">Yamaha</option>

            <option value="TVS">TVS</option>

            <option value="KTM">KTM</option>

            <option value="Bajaj">Bajaj</option>

            <option value="Suzuki">Suzuki</option>

        </select>

        <input
            type="text"
            name="city"
            placeholder="City">

        <input
            type="number"
            name="min_price"
            placeholder="Min Price">

        <input
            type="number"
            name="max_price"
            placeholder="Max Price">

        <button type="submit">

            Search

        </button>

    </form>



    <div class="bike-grid">

        <% if(bikes.length > 0){ %>

            <% bikes.forEach(bike=>{ %>

                <div class="bike-card">

                    <div class="bike-image">

                        <img

                        src="<%= bike.image ? '/uploads/bikes/' + bike.image : '/uploads/bikes/default-bike.jpg' %>"

                        alt="<%= bike.bike_name %>">

                    </div>

                    <div class="bike-content">

                        <h2>

                            <%= bike.bike_name %>

                        </h2>

                        <p>

                            <strong>Brand:</strong>

                            <%= bike.brand %>

                        </p>

                        <p>

                            <strong>Model:</strong>

                            <%= bike.model %>

                        </p>

                        <p>

                            <strong>Year:</strong>

                            <%= bike.year %>

                        </p>

                        <h3>

                            ₹ <%= bike.price %>

                        </h3>

                        <p>

                            📍 <%= bike.city %>

                        </p>

                        <a

                        href="/bikes/<%= bike.id %>"

                        class="view-btn">

                            View Details

                        </a>

                    </div>

                </div>

            <% }) %>

        <% } else { %>

            <h2>No Bikes Found</h2>

        <% } %>

    </div>

</section>



<%- include("partials/footer") %>