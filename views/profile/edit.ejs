<%- include('../partials/header', {title: 'Edit Profile'}) %>
<%- include('../partials/navbar') %>

<div class="profile-page">
    <div class="container">
        <div class="profile-layout">
            <div class="profile-main-card">
                <div class="page-header">
                    <div>
                        <h1><i class="fas fa-user-edit"></i> Edit Profile</h1>
                        <p>Update your personal information and profile picture.</p>
                    </div>
                    <a href="/profile" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Back to Profile</a>
                </div>

                <form action="/profile/edit" method="POST" enctype="multipart/form-data" class="profile-form">
                    <!-- Avatar Upload -->
                    <div class="avatar-edit-box">
                        <img src="/uploads/avatars/<%= profileUser.profile_photo || 'default-avatar.png' %>"
                            alt="<%= profileUser.first_name %>" class="avatar-preview" id="avatarPreview"
                            onerror="this.src='/images/default-avatar.png'">
                        <div class="avatar-upload-btn-wrap">
                            <label for="profile_photo" class="btn btn-sm btn-outline"><i class="fas fa-camera"></i> Change Photo</label>
                            <input type="file" name="profile_photo" id="profile_photo" accept=".jpg,.jpeg,.png,.webp" style="display:none" onchange="previewAvatar(this)">
                            <small class="form-hint">JPG, PNG, WEBP max 3MB</small>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>First Name *</label>
                            <input type="text" name="first_name" class="form-control" value="<%= profileUser.first_name %>" required>
                        </div>
                        <div class="form-group">
                            <label>Last Name *</label>
                            <input type="text" name="last_name" class="form-control" value="<%= profileUser.last_name %>" required>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Email Address</label>
                            <input type="email" class="form-control" value="<%= profileUser.email %>" disabled>
                            <small class="form-hint">Email cannot be changed directly for security reasons.</small>
                        </div>
                        <div class="form-group">
                            <label>Mobile Number *</label>
                            <input type="tel" name="phone" class="form-control" maxlength="10" value="<%= profileUser.phone %>" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Address</label>
                        <textarea name="address" class="form-control" rows="2"><%= profileUser.address || '' %></textarea>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>City</label>
                            <input type="text" name="city" class="form-control" value="<%= profileUser.city || '' %>">
                        </div>
                        <div class="form-group">
                            <label>District</label>
                            <input type="text" name="district" class="form-control" value="<%= profileUser.district || '' %>">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Mandal</label>
                            <input type="text" name="mandal" class="form-control" value="<%= profileUser.mandal || '' %>">
                        </div>
                        <div class="form-group">
                            <label>State</label>
                            <input type="text" name="state" class="form-control" value="<%= profileUser.state || '' %>">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Pincode</label>
                        <input type="text" name="pincode" class="form-control" maxlength="6" value="<%= profileUser.pincode || '' %>">
                    </div>

                    <div class="form-actions mt-24">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Profile</button>
                        <a href="/profile" class="btn btn-outline">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
function previewAvatar(input) {
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById('avatarPreview').src = e.target.result;
        };
        reader.readAsDataURL(input.files[0]);
    }
}
</script>

<%- include('../partials/footer') %>
