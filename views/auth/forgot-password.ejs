<%- include('../partials/header', {title: 'Forgot Password'}) %>
<%- include('../partials/navbar') %>

<div class="auth-page">
    <div class="container">
        <div class="auth-container">
            <div class="auth-left">
                <div class="auth-left-content">
                    <a href="/" class="auth-logo"><i class="fas fa-car-side"></i> Vehicle<strong>Hub</strong></a>
                    <h2>Reset Your Password</h2>
                    <p>Don't worry! Enter your registered email or mobile number to regain access to your account.</p>
                    <div class="auth-features">
                        <div class="auth-feature-item"><i class="fas fa-shield-alt"></i> Fast & Secure Reset</div>
                        <div class="auth-feature-item"><i class="fas fa-lock"></i> End-to-end Encrypted</div>
                        <div class="auth-feature-item"><i class="fas fa-clock"></i> Link Valid for 1 Hour</div>
                    </div>
                </div>
            </div>
            <div class="auth-right">
                <div class="auth-form-wrapper">
                    <h2>Forgot Password?</h2>
                    <p class="auth-subtitle">Remember your password? <a href="/login">Back to Login</a></p>

                    <% if (typeof reset_link !== 'undefined' && reset_link) { %>
                    <div class="alert alert-success" style="display:flex;flex-direction:column;align-items:flex-start;gap:8px;margin-bottom:20px;padding:16px;">
                        <div style="font-weight:700;font-size:15px;"><i class="fas fa-check-circle"></i> Reset Link Generated!</div>
                        <p style="font-size:13px;margin:0;">Click the button below to set your new password:</p>
                        <a href="<%= reset_link %>" class="btn btn-primary btn-block" style="margin-top:8px;">
                            <i class="fas fa-key"></i> Proceed to Set New Password
                        </a>
                    </div>
                    <% } %>

                    <form action="/forgot-password" method="POST" class="auth-form">
                        <div class="form-group">
                            <label for="identifier"><i class="fas fa-envelope"></i> Registered Email or Mobile Number *</label>
                            <input type="text" id="identifier" name="identifier" class="form-control"
                                placeholder="Enter your email or 10-digit mobile" required autocomplete="username">
                            <small class="text-muted" style="font-size:12px;display:block;margin-top:4px;">
                                We'll generate a secure password reset link for your account.
                            </small>
                        </div>

                        <button type="submit" class="btn btn-primary btn-block">
                            <i class="fas fa-paper-plane"></i> Send Password Reset Link
                        </button>
                    </form>

                    <div style="text-align:center;margin-top:24px;">
                        <a href="/login" class="btn-link" style="font-size:13px;"><i class="fas fa-arrow-left"></i> Return to Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
