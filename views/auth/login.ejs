<%- include('../partials/header', {title: 'Login'}) %>
<%- include('../partials/navbar') %>

<div class="auth-page">
    <div class="auth-container">
        <div class="auth-left">
            <div class="auth-left-content">
                <a href="/" class="auth-logo"><i class="fas fa-car-side"></i> Vehicle<strong>Hub</strong></a>
                <h2>Welcome Back!</h2>
                <p>Login to access your dashboard, listings, messages, and favorites.</p>
                <div class="auth-features">
                    <div class="auth-feature-item"><i class="fas fa-check-circle"></i> Browse thousands of vehicles</div>
                    <div class="auth-feature-item"><i class="fas fa-check-circle"></i> Contact sellers directly</div>
                    <div class="auth-feature-item"><i class="fas fa-check-circle"></i> Save your favorites</div>
                    <div class="auth-feature-item"><i class="fas fa-check-circle"></i> Sell your vehicle for free</div>
                </div>
            </div>
        </div>
        <div class="auth-right">
            <div class="auth-form-wrapper">
                <h2>Login to VehicleHub</h2>
                <p class="auth-subtitle">Don't have an account? <a href="/register">Register Free</a></p>

                <% if (typeof redirect !== 'undefined' && redirect && redirect !== '/dashboard') { %>
                <div class="alert alert-info"><i class="fas fa-info-circle"></i> Please login to continue.</div>
                <% } %>
                <% if (typeof query !== 'undefined' && query.logged_out) { %>
                <div class="alert alert-success"><i class="fas fa-check-circle"></i> You have been logged out successfully.</div>
                <% } %>

                <form action="/login<%= typeof redirect !== 'undefined' && redirect ? '?redirect=' + encodeURIComponent(redirect) : '' %>" method="POST" class="auth-form" id="loginForm" novalidate>
                    <div class="form-group">
                        <label for="login_identifier"><i class="fas fa-envelope"></i> Email or Mobile Number</label>
                        <input type="text" id="login_identifier" name="login_identifier"
                            class="form-control" placeholder="Enter your email or 10-digit mobile"
                            value="<%= formData.login_identifier || '' %>" required autocomplete="username">
                    </div>

                    <div class="form-group">
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <label for="password" style="margin-bottom:0;"><i class="fas fa-lock"></i> Password</label>
                            <a href="/forgot-password" class="forgot-pwd-link" style="font-size:12px;font-weight:600;color:var(--primary);">Forgot password?</a>
                        </div>
                        <div class="password-field" style="margin-top:6px;">
                            <input type="password" id="password" name="password"
                                class="form-control" placeholder="Enter your password"
                                required autocomplete="current-password">
                            <button type="button" class="toggle-password" data-target="password" aria-label="Show password">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="fas fa-sign-in-alt"></i> Login
                    </button>
                </form>

                <p class="auth-footer-note">By logging in, you agree to VehicleHub's Terms of Use.</p>
            </div>
        </div>
    </div>
</div>

<script>
const loginForm = document.getElementById('loginForm');
loginForm.addEventListener('submit', function(e) {
    const id = document.getElementById('login_identifier').value.trim();
    const pw = document.getElementById('password').value;
    if (!id) { e.preventDefault(); alert('Please enter your email or mobile number.'); return; }
    if (!pw) { e.preventDefault(); alert('Please enter your password.'); return; }
});
</script>
<%- include('../partials/footer') %>
