<%- include('../partials/header', {title: 'Set New Password'}) %>
<%- include('../partials/navbar') %>

<div class="auth-page">
    <div class="container">
        <div class="auth-container">
            <div class="auth-left">
                <div class="auth-left-content">
                    <a href="/" class="auth-logo"><i class="fas fa-car-side"></i> Vehicle<strong>Hub</strong></a>
                    <h2>Create New Password</h2>
                    <p>Choose a strong password with at least 8 characters to keep your vehicle listings and account secure.</p>
                    <div class="auth-features">
                        <div class="auth-feature-item"><i class="fas fa-check-circle"></i> Minimum 8 characters</div>
                        <div class="auth-feature-item"><i class="fas fa-check-circle"></i> Mix of letters & numbers</div>
                        <div class="auth-feature-item"><i class="fas fa-check-circle"></i> Instant account access</div>
                    </div>
                </div>
            </div>
            <div class="auth-right">
                <div class="auth-form-wrapper">
                    <h2>Reset Password</h2>
                    <p class="auth-subtitle">Account: <strong><%= user.email %></strong></p>

                    <form action="/reset-password" method="POST" class="auth-form" id="resetPasswordForm">
                        <input type="hidden" name="token" value="<%= token %>">

                        <div class="form-group">
                            <label for="password"><i class="fas fa-lock"></i> New Password *</label>
                            <div class="password-field">
                                <input type="password" id="password" name="password" class="form-control"
                                    placeholder="Enter at least 8 characters" minlength="8" required autocomplete="new-password">
                                <button type="button" class="toggle-password" data-target="password" aria-label="Show password">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="confirm_password"><i class="fas fa-lock"></i> Confirm New Password *</label>
                            <div class="password-field">
                                <input type="password" id="confirm_password" name="confirm_password" class="form-control"
                                    placeholder="Re-enter your new password" minlength="8" required autocomplete="new-password">
                                <button type="button" class="toggle-password" data-target="confirm_password" aria-label="Show password">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-block">
                            <i class="fas fa-check-circle"></i> Update & Set New Password
                        </button>
                    </form>

                    <div style="text-align:center;margin-top:20px;">
                        <a href="/login" class="btn-link" style="font-size:13px;"><i class="fas fa-arrow-left"></i> Cancel and Return to Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
const resetForm = document.getElementById('resetPasswordForm');
if (resetForm) {
    resetForm.addEventListener('submit', function(e) {
        const p1 = document.getElementById('password').value;
        const p2 = document.getElementById('confirm_password').value;
        if (p1.length < 8) {
            e.preventDefault();
            alert('New password must be at least 8 characters long.');
            return;
        }
        if (p1 !== p2) {
            e.preventDefault();
            alert('Passwords do not match. Please re-enter.');
            return;
        }
    });
}
</script>

<%- include('../partials/footer') %>
