<%- include('../partials/header', {title: 'Server Error'}) %>
<%- include('../partials/navbar') %>

<div class="error-page">
    <div class="container text-center">
        <div class="error-box">
            <div class="error-code">500</div>
            <h2>Internal Server Error</h2>
            <p>Something went wrong on our end. Our technical team has been notified. Please try again in a few moments.</p>
            <% if (error) { %>
            <div class="dev-error-trace mt-16" style="text-align:left;background:#1e293b;color:#f87171;padding:16px;border-radius:8px;font-family:monospace;font-size:12px;overflow-x:auto;">
                <%= error %>
            </div>
            <% } %>
            <div class="error-actions mt-24">
                <a href="/" class="btn btn-primary"><i class="fas fa-home"></i> Return Home</a>
                <a href="javascript:location.reload()" class="btn btn-outline"><i class="fas fa-redo"></i> Try Again</a>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
