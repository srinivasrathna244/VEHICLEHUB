# ==========================================
# VEHICLEHUB - Environment Configuration Example
# ==========================================

# Server Port
PORT=3000
NODE_ENV=development

# Session Secret (Change in production to a long random string)
SESSION_SECRET=vehiclehub_secure_session_key_replace_in_production

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=bikehub

# Official Traffic Challan & Verification API (Optional)
# When omitted, system defaults to legal fallback: "Official challan verification is currently unavailable."
CHALLAN_API_URL=
CHALLAN_API_KEY=
RC_VERIFY_API_URL=
RC_VERIFY_API_KEY=
